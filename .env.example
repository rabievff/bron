# Пример настроек. Скопируйте в .env и подставьте свои значения.
# Файл .env добавлен в .gitignore и в репозиторий не попадает.

# --- База данных -----------------------------------------------------
# Путь к файлу SQLite. По умолчанию office.db в корне проекта.
BOOKING_DB=office.db

# Количество кабинетов в офисе.
BOOKING_ROOMS=5

# Рабочие часы: бронирование вне этого интервала запрещено.
BOOKING_DAY_START=08:00
BOOKING_DAY_END=22:00

# --- Почта -----------------------------------------------------------
# Пока SMTP_HOST пуст, письма печатаются в консоль и никуда не уходят.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=noreply@office.local
SMTP_SENDER_NAME=Бронирование кабинетов

# STARTTLS (порт 587). Для порта 465 автоматически используется SSL.
SMTP_USE_TLS=1

# Пример для Gmail: пароль приложения, а не основной пароль аккаунта.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_SENDER=you@gmail.com
