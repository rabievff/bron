# Скомпилированные бинарники.
# Ведущий слэш обязателен: без него шаблон «booking» скрыл бы и
# каталог internal/booking с исходниками.
/booking
/booking.exe
*.exe
*.dll
*.so
*.dylib

# Артефакты тестов и профилирования
*.test
*.out
coverage.html

# Каталог сборки
/bin/
/dist/

# База данных SQLite (создаётся локально командой `init`)
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite3

# Локальные настройки со SMTP-паролями
.env

# Служебные файлы IDE и ОС
.idea/
.vscode/
.DS_Store
Thumbs.db

# Каталог зависимостей, если используется vendoring
# (по умолчанию модули берутся из кэша Go, каталог не нужен)
/vendor/
